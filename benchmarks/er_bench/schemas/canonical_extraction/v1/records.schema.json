          "items": {"$ref": "#/$defs/page"}
        },
        "sections": {
          "type": "array",
          "items": {"$ref": "#/$defs/section"}
        },
        "blocks": {
          "type": "array",
          "items": {"$ref": "#/$defs/block"}
        },
        "tables": {
          "type": "array",
          "items": {"$ref": "#/$defs/table"}
        },
        "table_families": {
          "type": "array",
          "items": {"$ref": "#/$defs/table_family"}
        },
        "figures": {
          "type": "array",
          "items": {"$ref": "#/$defs/figure"}
        },
        "images": {
          "type": "array",
          "items": {"$ref": "#/$defs/image"}
        },
        "assets": {
          "type": "array",
          "items": {"$ref": "#/$defs/asset"}
        },
        "cross_references": {
          "type": "array",
          "items": {"$ref": "#/$defs/cross_reference"}
        },
        "routing_observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/routing_observation"}
        },
        "table_stage_observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/table_stage_observation"}
        },
        "conversion_observations": {
          "type": "array",
          "items": {"$ref": "#/$defs/conversion_observation"}
        },
        "raw_mappings": {
          "type": "array",
          "items": {"$ref": "#/$defs/raw_mapping"}
        }
      },
      "additionalProperties": false
    }
  }
