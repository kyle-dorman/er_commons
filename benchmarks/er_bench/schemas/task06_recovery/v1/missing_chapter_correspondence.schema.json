{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/task06_recovery/v1/missing_chapter_correspondence.schema.json",
  "title": "ER Commons Task 06E missing-chapter correspondence",
  "type": "object",
  "required": ["schema_version", "records"],
  "properties": {
    "schema_version": {"const": "er_commons.recovery.missing_chapter_correspondence.v1"},
    "records": {
      "type": "array",
      "items": {"$ref": "#/$defs/record"},
      "minItems": 1,
      "uniqueItems": true
    }
  },
  "additionalProperties": false,
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "record_id": {"type": "string", "pattern": "^exv1-[0-9a-f]{64}/[a-z-]+/[a-z0-9_/-]+$"},
    "artifact_ref": {
      "type": "object",
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      },
      "additionalProperties": false
    },
    "record": {
      "type": "object",
      "required": [
        "schema_version", "stage_role", "change_class", "policy_version",
        "source_id", "chapter_marker", "chapter_title", "representation",
        "decision_ref", "old_targets", "new_target", "retained_heading_block_ids",
        "ordered_child_refs", "chapter_scope_content_ids", "direct_content_ownership", "logical_content_page_extent",
        "following_boundary_record_id", "scope_boundary_record_id", "following_boundary_kind", "content_record_count",
        "content_record_ids_unique"
      ],
      "properties": {
        "schema_version": {"const": "er_commons.recovery.stage_correspondence.v1"},
        "stage_role": {"const": "semantic_sections_and_target_aliases"},
        "change_class": {"const": "distinct_missing_whole_chapter_target"},
        "policy_version": {"const": "missing_whole_chapter_v1"},
        "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
        "chapter_marker": {"type": "string", "pattern": "^[0-9]{1,2}$"},
        "chapter_title": {"type": "string", "minLength": 1},
        "representation": {"enum": ["recovered_composite", "toc_children_fallback"]},
        "decision_ref": {"$ref": "#/$defs/artifact_ref"},
        "old_targets": {"type": "array", "maxItems": 0},
        "new_target": {
          "type": "object",
          "required": ["section_id", "state"],
          "properties": {
            "section_id": {"$ref": "#/$defs/record_id"},
            "state": {"const": "projected_candidate_local"}
          },
          "additionalProperties": false
        },
        "retained_heading_block_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/record_id"},
          "uniqueItems": true
        },
        "ordered_child_refs": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "minItems": 1,
          "uniqueItems": true
        },
        "chapter_scope_content_ids": {
          "type": "array",
          "items": {"$ref": "#/$defs/record_id"},
          "minItems": 1,
          "uniqueItems": true
        },
        "direct_content_ownership": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["content_record_id", "source_stable_item_key", "original_owner_section_id", "current_owner_section_id", "chapter_scope_section_id"],
            "properties": {
              "content_record_id": {"$ref": "#/$defs/record_id"},
              "source_stable_item_key": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
              "original_owner_section_id": {"$ref": "#/$defs/record_id"},
              "current_owner_section_id": {"$ref": "#/$defs/record_id"},
              "chapter_scope_section_id": {"$ref": "#/$defs/record_id"}
            },
            "additionalProperties": false
          },
          "uniqueItems": true
        },
        "logical_content_page_extent": {
          "type": "array",
          "prefixItems": [
            {"type": "integer", "minimum": 1},
            {"type": "integer", "minimum": 1}
          ],
          "minItems": 2,
          "maxItems": 2
        },
        "following_boundary_record_id": {"type": "string", "minLength": 1},
        "scope_boundary_record_id": {"type": "string", "minLength": 1},
        "following_boundary_kind": {"enum": ["following_heading", "document_end"]},
        "content_record_count": {"type": "integer", "minimum": 0},
        "content_record_ids_unique": {"const": true}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"representation": {"const": "recovered_composite"}}, "required": ["representation"]},
          "then": {"properties": {"retained_heading_block_ids": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"representation": {"const": "toc_children_fallback"}}, "required": ["representation"]},
          "then": {"properties": {"retained_heading_block_ids": {"maxItems": 0}}}
        }
      ]
    }
  }
}
