{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object", "additionalProperties": false,
  "required": ["schema_version", "repository_root", "data_root", "accepted_repository_commit", "tmux_session", "initial_attempt_number", "source_order", "page_count", "generator_files", "repository_control_refs", "collection_production_identity_recipe", "namespaces", "resource_policy", "phases"],
  "properties": {
    "schema_version": {"const": "er_commons.task06g_collection_generation.v1"},
    "repository_root": {"const": "../../.."},
    "data_root": {"const": "${ER_COMMONS_DATA_ROOT}"},
    "accepted_repository_commit": {"const": "ff5613075c1e73d66e487381566e33dbfc6778f4"},
    "tmux_session": {"const": "er-commons-06g-replay-v34"},
    "initial_attempt_number": {"const": 17},
    "source_order": {"type": "array", "minItems": 35, "maxItems": 35, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "page_count": {"const": 49022},
    "generator_files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "repository_control_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ref"}},
    "collection_production_identity_recipe": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "destination", "collection_spec_destination", "imported_selection_destination", "collection_output_namespace", "source_catalog_ref", "source_policy_refs"],
      "properties": {
        "schema_version": {"const": "er_commons.task06g.collection_production_identity_recipe.v1"},
        "destination": {"const": "collection_production_identity.json"},
        "collection_spec_destination": {"const": "task06g_collection_only_v1.json"},
        "imported_selection_destination": {"const": "task06g_imported_document_selection_v1.json"},
        "collection_output_namespace": {"const": "pipelines/brisbane_baylands/task_06_recovery_v1/06g/replay_v34/document_publications"},
        "source_catalog_ref": {"$ref": "#/$defs/ref"},
        "source_policy_refs": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/ref"}}
      }
    },
    "namespaces": {"type": "object", "required": ["document_input_root", "replay_root", "collection_output_root", "recovery_root", "launch_root", "attempt_root", "progress_root", "log_path"], "additionalProperties": {"type": "string", "minLength": 1}},
    "resource_policy": {"const": {"max_swap_growth_bytes": 0, "external_reserve_bytes": 67108864, "remaining_before_v34_bytes": 4038649798, "predicted_maximum_additional_bytes": 1443089302}},
    "phases": {"type": "object", "required": ["initial", "comparison"], "additionalProperties": false, "properties": {"initial": {"$ref": "#/$defs/phase"}, "comparison": {"$ref": "#/$defs/phase"}}}
  },
  "$defs": {
    "ref": {"type": "object", "additionalProperties": false, "required": ["authority", "path", "sha256", "byte_size"], "properties": {"authority": {"enum": ["repository", "artifact_root"]}, "path": {"type": "string", "minLength": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "byte_size": {"type": "integer", "minimum": 0}}},
    "phase": {"type": "object", "additionalProperties": false, "required": ["directory", "specs"], "properties": {"directory": {"enum": ["00_initial", "20_comparison"]}, "specs": {"type": "array", "minItems": 1, "items": {"type": "object"}}}}
  }
}
