{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/collection-processing/v2/collection_run_spec.schema.json",
  "title": "ER Commons collection run specification v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "document_run_spec",
    "source_ids",
    "source_family_catalog_relative_path",
    "blocking_policy",
    "target_policy_sha256",
    "resolution_policy_sha256"
  ],
  "properties": {
    "schema_version": {"const": "er_commons.collection_run_spec.v2"},
    "document_run_spec": {"$ref": "#/$defs/relative_path"},
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"}
    },
    "source_family_catalog_relative_path": {"$ref": "#/$defs/relative_path"},
    "blocking_policy": {"enum": ["all_sources_successful", "terminal_failures_allowed"]},
    "document_evidence_mode": {
      "enum": ["document_attempt", "downstream_replay_only"],
      "default": "document_attempt"
    },
    "target_policy_sha256": {"$ref": "#/$defs/sha256"},
    "resolution_policy_sha256": {"$ref": "#/$defs/sha256"},
    "ordering_policy_version": {"const": "record_target_order_v2", "default": "record_target_order_v2"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    }
  }
}
