{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "task08b.selection.v1"
    },
    "namespace": {
      "enum": [
        "synthetic",
        "dataset"
      ]
    },
    "group": {
      "type": "string"
    },
    "input_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "project_id": {
      "type": "integer",
      "minimum": 1
    },
    "export_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "status": {
      "enum": [
        "pending",
        "complete"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "comment_id": {
            "type": "string"
          },
          "comment_label": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 1
          },
          "input_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "proposal_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "task_id": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "reviewed",
              "unreviewed",
              "pending_draft",
              "pending_cancelled"
            ]
          },
          "decision": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "selection": {
                    "enum": [
                      "Excluded",
                      "Reviewed skip",
                      "Selected",
                      "Unresolved"
                    ]
                  },
                  "selection_reason": {
                    "enum": [
                      "Ambiguous concern",
                      "Clear scoped concern",
                      "Multiple independent asks",
                      "Other",
                      "Source or eligibility concern",
                      "Weaker candidate"
                    ]
                  },
                  "eligibility": {
                    "enum": [
                      "Ineligible",
                      "Not assessed",
                      "Provisionally eligible",
                      "Unresolved"
                    ]
                  },
                  "eligibility_reason": {
                    "enum": [
                      "External evidence dependence",
                      "Incidental revision exception",
                      "Material later revision",
                      "Mitigation change",
                      "Needs further review",
                      "New Final EIR analysis",
                      "Not assessed",
                      "Original Draft EIR basis appears usable",
                      "Other",
                      "Unavailable visual evidence",
                      "Unusable source"
                    ]
                  },
                  "review_progress": {
                    "enum": [
                      "Continue",
                      "Stop here"
                    ]
                  },
                  "notes": {
                    "type": "string"
                  },
                  "stop_reason": {
                    "enum": [
                      "Enough candidates",
                      "No more suitable candidates",
                      "Other",
                      "Unresolved decisions remain"
                    ]
                  }
                },
                "required": [
                  "selection",
                  "selection_reason",
                  "eligibility",
                  "eligibility_reason",
                  "review_progress"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          },
          "provenance": {
            "anyOf": [
              {
                "type": "object",
                "properties": {
                  "annotation_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reviewer": {
                    "type": [
                      "integer",
                      "object"
                    ]
                  },
                  "created_at": {
                    "type": "string"
                  },
                  "updated_at": {
                    "type": "string"
                  }
                },
                "required": [
                  "annotation_id",
                  "reviewer",
                  "created_at",
                  "updated_at"
                ],
                "additionalProperties": false
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "comment_id",
          "comment_label",
          "rank",
          "input_sha256",
          "proposal_sha256",
          "task_id",
          "state",
          "decision",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "native_tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "selected_comment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "maxItems": 3,
      "uniqueItems": true
    },
    "advancing_comment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "reviewed_ranks": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 1
      },
      "uniqueItems": true
    },
    "last_reviewed_position": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 1
    },
    "untouched_comment_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "stopping_point": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "explicit",
            "selection_limit",
            "exhausted",
            "pending"
          ]
        },
        "rank": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "rank",
        "reason"
      ],
      "additionalProperties": false
    },
    "counts": {
      "type": "object",
      "properties": {
        "candidates": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed": {
          "type": "integer",
          "minimum": 0
        },
        "selected": {
          "type": "integer",
          "minimum": 0
        },
        "advancing": {
          "type": "integer",
          "minimum": 0
        },
        "reviewed_skips": {
          "type": "integer",
          "minimum": 0
        },
        "excluded": {
          "type": "integer",
          "minimum": 0
        },
        "unresolved": {
          "type": "integer",
          "minimum": 0
        },
        "unreviewed": {
          "type": "integer",
          "minimum": 0
        },
        "pending": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "candidates",
        "reviewed",
        "selected",
        "advancing",
        "reviewed_skips",
        "excluded",
        "unresolved",
        "unreviewed",
        "pending"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schema_version",
    "namespace",
    "group",
    "input_sha256",
    "proposal_sha256",
    "project_id",
    "export_sha256",
    "status",
    "records",
    "native_tasks",
    "selected_comment_ids",
    "advancing_comment_ids",
    "reviewed_ranks",
    "last_reviewed_position",
    "untouched_comment_ids",
    "stopping_point",
    "counts"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
