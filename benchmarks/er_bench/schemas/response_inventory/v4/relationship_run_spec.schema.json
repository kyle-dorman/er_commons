{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/response_inventory/v4/relationship_run_spec.schema.json",
  "title": "ER Commons Task 05E bounded relationship review run specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "task_stage",
    "scope_kind",
    "accepted_task05d",
    "accepted_gate1",
    "repository_bindings",
    "producer_code_sha256",
    "output_policy",
    "resolution_policy"
  ],
  "properties": {
    "schema_version": {"const": "er_commons.response_relationship_run_spec.v4"},
    "task_stage": {"const": "05e"},
    "scope_kind": {"const": "bounded_relationship_review"},
    "accepted_task05d": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_root", "acceptance_path", "revision_id", "acceptance_id", "activity_id", "completion_id", "inventory_id", "semantic_digest"],
      "properties": {
        "candidate_root": {"$ref": "#/$defs/relative_path"},
        "acceptance_path": {"$ref": "#/$defs/relative_path"},
        "revision_id": {"type": "string", "pattern": "^revisionv1-[0-9a-f]{64}$"},
        "acceptance_id": {"type": "string", "pattern": "^acceptancev1-[0-9a-f]{64}$"},
        "activity_id": {"type": "string", "pattern": "^activityv1-[0-9a-f]{64}$"},
        "completion_id": {"type": "string", "pattern": "^completionv1-[0-9a-f]{64}$"},
        "inventory_id": {"type": "string", "pattern": "^fileinventoryv1-[0-9a-f]{64}$"},
        "semantic_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "accepted_gate1": {
      "type": "object",
      "additionalProperties": false,
      "required": ["baseline_root", "activity_id", "census_digest"],
      "properties": {
        "baseline_root": {"$ref": "#/$defs/relative_path"},
        "activity_id": {"type": "string", "pattern": "^activityv1-[0-9a-f]{64}$"},
        "census_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "repository_bindings": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {"$ref": "#/$defs/repository_binding"}
    },
    "producer_code_sha256": {"$ref": "#/$defs/sha256"},
    "output_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifact_relative_root", "review_namespace_template", "completion_written", "copy_source_payload", "copy_upstream_payloads"],
      "properties": {
        "artifact_relative_root": {"$ref": "#/$defs/relative_path"},
        "review_namespace_template": {"const": "working/05e/reviewpassv1-{activity_hash}"},
        "completion_written": {"const": false},
        "copy_source_payload": {"const": false},
        "copy_upstream_payloads": {"const": false}
      }
    },
    "resolution_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["normalize_case", "collapse_whitespace", "recover_u0002_separator_in_reference_mentions", "classify_self_mentions_without_edges", "allow_general_response_response_edges", "allow_general_response_general_response_edges", "classify_running_headers_without_edges", "classify_response_section_headings_without_edges", "classify_ordinary_response_prose_without_edges", "terminal_unresolved_reference_labels", "terminal_unpaired_source_labels", "typed_membership_suffix", "membership_aliases", "strip_one_terminal_period", "infer_letter_suffix_relationships", "fuzzy_or_semantic_matching"],
      "properties": {
        "normalize_case": {"const": true},
        "collapse_whitespace": {"const": true},
        "recover_u0002_separator_in_reference_mentions": {"const": true},
        "classify_self_mentions_without_edges": {"const": true},
        "allow_general_response_response_edges": {"const": true},
        "allow_general_response_general_response_edges": {"const": true},
        "classify_running_headers_without_edges": {"const": true},
        "classify_response_section_headings_without_edges": {"const": true},
        "classify_ordinary_response_prose_without_edges": {"const": true},
        "terminal_unresolved_reference_labels": {"const": ["Response OSEC-21"]},
        "terminal_unpaired_source_labels": {"const": ["Comment SA-Caltrans-48", "Response SA-Caltrans-48a"]},
        "typed_membership_suffix": {"const": true},
        "membership_aliases": {
          "const": {
            "O-OSEC-106": "M-OSEC-106",
            "O-OSEC-370": "M-OSEC-370",
            "O-OSEC-371": "M-OSEC-371",
            "O-OSEC-375": "M-OSEC-375",
            "O-OSEC-379": "M-OSEC-379"
          }
        },
        "strip_one_terminal_period": {"const": true},
        "infer_letter_suffix_relationships": {"const": false},
        "fuzzy_or_semantic_matching": {"const": false}
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "relative_path": {"type": "string", "minLength": 1, "not": {"pattern": "(^/|(^|/)\\.\\.(/|$))"}},
    "repository_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "authority", "path", "sha256"],
      "properties": {
        "role": {"enum": ["response_record_schema", "producer_run_spec_code", "relationship_run_spec_schema"]},
        "authority": {"const": "repository"},
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    }
  }
}
