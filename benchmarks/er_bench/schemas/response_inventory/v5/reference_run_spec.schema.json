{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/response_inventory/v5/reference_run_spec.schema.json",
  "title": "ER Commons Task 05F qualified exact Draft EIR reference run specification",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "task_stage", "scope_kind", "accepted_task05d",
    "accepted_task05e", "task04", "repository_bindings",
    "producer_code_sha256", "output_policy", "stop_behavior"
  ],
  "properties": {
    "schema_version": {"const": "er_commons.response_reference_run_spec.v5"},
    "task_stage": {"const": "05f"},
    "scope_kind": {"const": "qualified_exact_draft_eir_reference_rules"},
    "accepted_task05d": {"$ref": "#/$defs/accepted_task05d"},
    "accepted_task05e": {"$ref": "#/$defs/accepted_task05e"},
    "task04": {"$ref": "#/$defs/task04"},
    "repository_bindings": {
      "type": "array", "minItems": 5, "maxItems": 5,
      "items": {"$ref": "#/$defs/repository_binding"}
    },
    "producer_code_sha256": {"$ref": "#/$defs/sha256"},
    "output_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["artifact_relative_root", "candidate_namespace_template", "completion_written", "copy_source_payload", "copy_upstream_payloads"],
      "properties": {
        "artifact_relative_root": {"$ref": "#/$defs/relative_path"},
        "candidate_namespace_template": {"const": "working/05f/rulesv1-{activity_hash}"},
        "completion_written": {"const": false},
        "copy_source_payload": {"const": false},
        "copy_upstream_payloads": {"const": false}
      }
    },
    "stop_behavior": {
      "type": "object", "additionalProperties": false,
      "required": [
        "on_input_binding_mismatch", "on_invalid_record_or_schema", "on_population_mismatch",
        "exact_first", "leading_identifier_fallback", "attached_title_fallback",
        "structured_appendix_designator_normalization", "unique_outer_appendix_document",
        "reject_more_specific_appendix_downgrade", "block_known_f1_source_identity_failure",
        "source_filter_before_cardinality",
        "deduplicate_target_ids_before_cardinality", "fuzzy_or_semantic_matching",
        "source_pdf_access", "hash_large_upstream_payloads", "allow_policy_repair_during_run"
      ],
      "properties": {
        "on_input_binding_mismatch": {"const": "stop"},
        "on_invalid_record_or_schema": {"const": "stop"},
        "on_population_mismatch": {"const": "stop"},
        "exact_first": {"const": true},
        "leading_identifier_fallback": {"const": true},
        "attached_title_fallback": {"const": true},
        "structured_appendix_designator_normalization": {"const": true},
        "unique_outer_appendix_document": {"const": true},
        "reject_more_specific_appendix_downgrade": {"const": true},
        "block_known_f1_source_identity_failure": {"const": true},
        "source_filter_before_cardinality": {"const": true},
        "deduplicate_target_ids_before_cardinality": {"const": true},
        "fuzzy_or_semantic_matching": {"const": false},
        "source_pdf_access": {"const": false},
        "hash_large_upstream_payloads": {"const": false},
        "allow_policy_repair_during_run": {"const": false}
      }
    }
  },
