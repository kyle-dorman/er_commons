              ]
            },
            "fresh_review_status": {
              "type": "string",
              "minLength": 1
            },
            "text_only_model_eligibility": {
              "type": [
                "boolean",
                "null"
              ]
            }
          }
        },
        "final_f1_warning": {
          "type": [
            "object",
            "null"
