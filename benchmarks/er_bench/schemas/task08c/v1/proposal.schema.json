{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "model",
    "prompt_version",
    "packet_sha256",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "task08c.proposal.v1"
    },
    "model": {
      "const": "gpt-6-astra"
    },
    "prompt_version": {
      "const": "task08c.wording.v1"
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "neutral_id",
          "comment_text_sha256",
          "question",
          "rewrite_reason",
          "stop_reason"
        ],
        "properties": {
          "neutral_id": {
            "type": "string",
            "minLength": 1
          },
          "comment_text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "question": {
            "type": [
              "string",
              "null"
            ]
          },
          "rewrite_reason": {
            "type": "string"
          },
          "stop_reason": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
