{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "additionalProperties": false,
    "required": [
      "data",
      "predictions"
    ],
    "properties": {
      "data": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "form_version",
          "namespace",
          "neutral_id",
          "original_comment",
          "original_comment_sha256",
          "comment_text_sha256",
          "comment_source_warnings",
          "packet_sha256",
          "proposal_sha256",
          "proposed_question",
          "warnings_html"
        ],
        "properties": {
          "form_version": {
            "const": "task08c.wording.v1"
          },
          "namespace": {
            "enum": [
              "dataset",
              "synthetic"
            ]
          },
          "neutral_id": {
            "type": "string",
            "minLength": 1
          },
          "original_comment": {
            "type": "string",
            "minLength": 1
          },
          "original_comment_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "comment_text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "comment_source_warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "packet_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "proposal_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "proposed_question": {
            "type": [
              "string",
              "null"
            ]
          },
          "warnings_html": {
            "type": "string"
          }
        }
      },
      "predictions": {
        "type": "array",
        "minItems": 1,
        "maxItems": 1,
        "items": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "model_version",
            "result"
          ],
          "properties": {
            "model_version": {
              "const": "task08c.wording.v1"
            },
            "result": {
              "type": "array",
              "maxItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "from_name",
                  "to_name",
                  "type",
                  "value"
                ],
                "properties": {
                  "from_name": {
                    "const": "question"
                  },
                  "to_name": {
                    "const": "comment"
                  },
                  "type": {
                    "const": "textarea"
                  },
                  "value": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "text"
                    ],
                    "properties": {
                      "text": {
                        "type": "array",
                        "minItems": 1,
                        "maxItems": 1,
                        "items": {
                          "type": "string"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
