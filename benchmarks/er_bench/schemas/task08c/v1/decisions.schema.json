{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "namespace",
    "packet_sha256",
    "proposal_sha256",
    "project_id",
    "reviewer_id",
    "export_sha256",
    "records",
    "native_tasks",
    "advancing_neutral_ids",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "task08c.wording.v1"
    },
    "namespace": {
      "enum": [
        "synthetic",
        "dataset"
      ]
    },
    "packet_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "proposal_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "project_id": {
      "type": "integer",
      "minimum": 1
    },
    "reviewer_id": {
      "type": "integer",
      "minimum": 1
    },
    "export_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "neutral_id",
          "original_comment_sha256",
          "comment_text_sha256",
          "packet_sha256",
          "proposal_sha256",
          "form_version",
          "task_id",
          "state",
          "decision",
          "saved_question",
          "note",
          "provenance",
          "frozen_question"
        ],
        "properties": {
          "neutral_id": {
            "type": "string",
            "minLength": 1
          },
          "original_comment_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "comment_text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "packet_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "proposal_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "form_version": {
            "const": "task08c.wording.v1"
          },
          "task_id": {
            "type": "integer",
            "minimum": 1
          },
          "state": {
            "enum": [
              "unreviewed",
              "pending_draft",
              "pending_cancelled",
              "approved",
              "rejected",
              "unresolved"
            ]
          },
          "decision": {
            "enum": [
              null,
              "Approve exact wording",
              "Reject",
              "Unresolved"
            ]
          },
          "saved_question": {
            "type": [
              "string",
              "null"
            ]
          },
          "note": {
            "type": [
              "string",
              "null"
            ]
          },
          "provenance": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "annotation_id",
                  "reviewer",
                  "created_at",
                  "updated_at"
                ],
                "properties": {
                  "annotation_id": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "reviewer": {},
                  "created_at": {
                    "type": "string",
                    "minLength": 1
                  },
                  "updated_at": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              }
            ]
          },
          "frozen_question": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "question_id",
                  "question_version",
                  "text",
                  "text_sha256"
                ],
                "properties": {
                  "question_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "question_version": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                }
              }
            ]
          }
        }
      }
    },
    "native_tasks": {
      "type": "array"
    },
    "advancing_neutral_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "status": {
      "enum": [
        "complete",
        "incomplete"
      ]
    }
  }
}
