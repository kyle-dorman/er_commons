{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "task08c.comment_only.v1"
    },
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "neutral_id",
          "original_comment",
          "comment_source_warnings",
          "original_comment_sha256",
          "comment_text_sha256"
        ],
        "properties": {
          "neutral_id": {
            "type": "string",
            "pattern": "^C00[1-3]$"
          },
          "original_comment": {
            "type": "string",
            "minLength": 1
          },
          "comment_source_warnings": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "original_comment_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "comment_text_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    }
  }
}
