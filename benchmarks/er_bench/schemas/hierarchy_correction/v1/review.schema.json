{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/hierarchy_correction/v1/review.schema.json",
  "title": "Held-out hierarchy review contract v1",
  "oneOf": [
    {"$ref": "#/$defs/annotation_bundle"},
    {"$ref": "#/$defs/evaluation"}
  ],
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stable_item_key", "expected_boundary", "expected_level", "expected_parent_key", "expected_regime_action", "source_ambiguous", "note"],
      "properties": {
        "stable_item_key": {"$ref": "#/$defs/key"},
        "expected_boundary": {"type": "boolean"},
        "expected_level": {"type": ["integer", "null"], "minimum": 1, "maximum": 6},
        "expected_parent_key": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]},
        "expected_regime_action": {"enum": ["none", "start", "end"]},
        "source_ambiguous": {"type": "boolean"},
        "note": {"type": "string"}
      },
      "allOf": [
        {
          "if": {"properties": {"expected_boundary": {"const": true}}},
          "then": {"properties": {"expected_level": {"type": "integer"}}},
          "else": {"properties": {"expected_level": {"type": "null"}, "expected_parent_key": {"type": "null"}}}
        }
      ]
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["physical_page", "source_render_sha256", "eligible_item_keys", "annotations"],
      "properties": {
        "physical_page": {"type": "integer", "minimum": 1},
        "source_render_sha256": {"$ref": "#/$defs/digest"},
        "eligible_item_keys": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true},
        "annotations": {"type": "array", "items": {"$ref": "#/$defs/annotation"}}
      }
    },
    "annotation_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "source_id", "source_sha256", "held_out_manifest_sha256", "policy_sha256", "code_bundle_sha256", "created_before_corrected_output", "post_review_tuning_allowed", "pages"],
      "properties": {
        "record_type": {"const": "held_out_annotations"},
        "schema_version": {"const": "1.0.0"},
        "source_id": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/digest"},
        "held_out_manifest_sha256": {"$ref": "#/$defs/digest"},
        "policy_sha256": {"$ref": "#/$defs/digest"},
        "code_bundle_sha256": {"$ref": "#/$defs/digest"},
        "created_before_corrected_output": {"const": true},
        "post_review_tuning_allowed": {"const": false},
        "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}}
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "candidate_id", "annotation_bundle_sha256", "evaluated_once", "mismatches", "false_boundary_count", "false_demotion_count", "missed_boundary_count", "wrong_level_or_parent_count", "regime_error_count", "source_ambiguous_count", "status"],
      "properties": {
        "record_type": {"const": "held_out_evaluation"},
        "schema_version": {"const": "1.0.0"},
        "candidate_id": {"type": "string", "pattern": "^hcorv1-[a-f0-9]{64}$"},
        "annotation_bundle_sha256": {"$ref": "#/$defs/digest"},
        "evaluated_once": {"const": true},
        "mismatches": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["stable_item_key", "kind"],
            "properties": {
              "stable_item_key": {"$ref": "#/$defs/key"},
              "kind": {"enum": ["false_boundary", "false_demotion", "missed_boundary", "wrong_level_or_parent", "regime_error"]}
            }
          }
        },
        "false_boundary_count": {"type": "integer", "minimum": 0},
        "false_demotion_count": {"type": "integer", "minimum": 0},
        "missed_boundary_count": {"type": "integer", "minimum": 0},
        "wrong_level_or_parent_count": {"type": "integer", "minimum": 0},
        "regime_error_count": {"type": "integer", "minimum": 0},
        "source_ambiguous_count": {"type": "integer", "minimum": 0},
        "status": {"enum": ["pass", "reject", "inconclusive"]}
      }
    }
  }
}
