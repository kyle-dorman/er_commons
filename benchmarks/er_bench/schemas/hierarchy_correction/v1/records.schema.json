    "metrics": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "fresh_wall_time_seconds", "median_fresh_wall_time_seconds", "stage_wall_time_seconds", "peak_rss_bytes", "input_bytes", "artifact_bytes", "producer_build_wall_time_seconds", "producer_bytes", "wall_time_ratio", "artifact_bytes_ratio", "cheap_relative_to_producer"], "properties": {"candidate_id": {"type": "string", "pattern": "^hcorv1-[a-f0-9]{64}$"}, "fresh_wall_time_seconds": {"type": "array", "minItems": 3, "maxItems": 3, "items": {"type": "number", "minimum": 0}}, "median_fresh_wall_time_seconds": {"type": "number", "minimum": 0}, "stage_wall_time_seconds": {"type": "object", "additionalProperties": false, "required": ["features", "toc_reconciliation", "rules", "hierarchy", "publication"], "properties": {"features": {"type": "number", "minimum": 0}, "toc_reconciliation": {"type": "number", "minimum": 0}, "rules": {"type": "number", "minimum": 0}, "hierarchy": {"type": "number", "minimum": 0}, "publication": {"type": "number", "minimum": 0}}}, "peak_rss_bytes": {"type": "integer", "minimum": 0}, "input_bytes": {"type": "integer", "minimum": 0}, "artifact_bytes": {"type": "integer", "minimum": 0}, "producer_build_wall_time_seconds": {"type": "number", "exclusiveMinimum": 0}, "producer_bytes": {"type": "integer", "exclusiveMinimum": 0}, "wall_time_ratio": {"type": "number", "minimum": 0}, "artifact_bytes_ratio": {"type": "number", "minimum": 0}, "cheap_relative_to_producer": {"type": "boolean"}}},
