    "rule_evidence": {"type": "object", "additionalProperties": false, "required": ["source_item_keys", "outline_level", "toc_entry_id", "numbering_kind", "numbering_depth", "previous_heading_key", "next_heading_key", "next_item_key", "left_delta_before_pt", "left_delta_after_pt", "next_list_indent_delta_pt", "transferred_level", "conflict_codes"], "properties": {"source_item_keys": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true}, "outline_level": {"type": ["integer", "null"], "minimum": 1}, "toc_entry_id": {"type": ["string", "null"], "pattern": "^toc-[a-f0-9]{16}$"}, "numbering_kind": {"enum": ["none", "decimal", "article", "upper_alpha", "upper_roman", "bullet"]}, "numbering_depth": {"type": ["integer", "null"], "minimum": 1}, "previous_heading_key": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]}, "next_heading_key": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]}, "next_item_key": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]}, "left_delta_before_pt": {"type": ["number", "null"], "minimum": 0}, "left_delta_after_pt": {"type": ["number", "null"], "minimum": 0}, "next_list_indent_delta_pt": {"type": ["number", "null"]}, "transferred_level": {"type": ["integer", "null"], "minimum": 1}, "conflict_codes": {"type": "array", "items": {"enum": ["TOC_ROW_UNPARSEABLE", "TOC_TARGET_MISSING", "TOC_TARGET_AMBIGUOUS", "TOC_PAGE_CONFLICT", "TOC_LEVEL_CONFLICT", "TOC_ORDER_CONFLICT", "NUMBERING_JUMP_UNSUPPORTED", "SIBLING_EVIDENCE_CONFLICT", "LOCAL_LEVEL_TRANSFER_CONFLICT", "RAW_HEADING_DEPTH_UNSUPPORTED"]}, "uniqueItems": true}}},
    "hierarchy": {"type": "object", "additionalProperties": false, "required": ["roots", "edges", "direct_membership", "unassigned_content"], "properties": {"roots": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true}, "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["parent_key", "child_key"], "properties": {"parent_key": {"$ref": "#/$defs/key"}, "child_key": {"$ref": "#/$defs/key"}}}}, "direct_membership": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["item_key", "heading_key"], "properties": {"item_key": {"$ref": "#/$defs/key"}, "heading_key": {"$ref": "#/$defs/key"}}}}, "unassigned_content": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true}}},
