  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "key": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["candidate_id", "producer_run_id", "source_sha256", "source_manifest_sha256", "producer_completion_sha256", "producer_inventory_sha256", "policy_version", "policy_sha256", "config_sha256", "schema_sha256", "code_bundle_sha256"], "properties": {"candidate_id": {"type": "string", "pattern": "^hcorv1-[a-f0-9]{64}$"}, "producer_run_id": {"type": "string", "pattern": "^prv1-[a-f0-9]{64}$"}, "source_sha256": {"$ref": "#/$defs/digest"}, "source_manifest_sha256": {"$ref": "#/$defs/digest"}, "producer_completion_sha256": {"$ref": "#/$defs/digest"}, "producer_inventory_sha256": {"$ref": "#/$defs/digest"}, "policy_version": {"const": "1.0.0"}, "policy_sha256": {"$ref": "#/$defs/digest"}, "config_sha256": {"$ref": "#/$defs/digest"}, "schema_sha256": {"$ref": "#/$defs/digest"}, "code_bundle_sha256": {"$ref": "#/$defs/digest"}}},
    "input_inventory": {"type": "object", "additionalProperties": false, "required": ["producer_completion_path", "producer_completion_sha256", "producer_inventory_path", "producer_inventory_sha256", "source_path", "source_sha256", "verified_file_count"], "properties": {"producer_completion_path": {"type": "string", "minLength": 1}, "producer_completion_sha256": {"$ref": "#/$defs/digest"}, "producer_inventory_path": {"type": "string", "minLength": 1}, "producer_inventory_sha256": {"$ref": "#/$defs/digest"}, "source_path": {"type": "string", "minLength": 1}, "source_sha256": {"$ref": "#/$defs/digest"}, "verified_file_count": {"type": "integer", "minimum": 1}}},
    "feature": {"type": "object", "additionalProperties": false, "required": ["stable_item_key", "raw_self_ref", "raw_parent_ref", "text", "orig", "normalized_text", "reading_order_index", "content_layer", "raw_role", "raw_level", "physical_page", "page_width", "page_height", "bbox", "charspan", "line_count", "left_pt", "height_pt", "regime_id", "toc_region", "numbering_kind", "numbering_token", "numbering_depth", "outline_state", "outline_level", "layout_state", "printed_page_label"], "properties": {"stable_item_key": {"$ref": "#/$defs/key"}, "raw_self_ref": {"type": "string", "pattern": "^#/texts/[0-9]+$"}, "raw_parent_ref": {"type": "string", "pattern": "^#/(?:body|furniture|groups/[0-9]+|pictures/[0-9]+|texts/[0-9]+)$"}, "text": {"type": "string"}, "orig": {"type": "string"}, "normalized_text": {"type": "string"}, "reading_order_index": {"type": "integer", "minimum": 0}, "content_layer": {"enum": ["body", "furniture"]}, "raw_role": {"type": "string"}, "raw_level": {"type": ["integer", "null"], "minimum": 1}, "physical_page": {"type": "integer", "minimum": 1}, "page_width": {"type": "number", "exclusiveMinimum": 0}, "page_height": {"type": "number", "exclusiveMinimum": 0}, "bbox": {"type": "object", "additionalProperties": false, "required": ["l", "t", "r", "b", "coord_origin"], "properties": {"l": {"type": "number"}, "t": {"type": "number"}, "r": {"type": "number"}, "b": {"type": "number"}, "coord_origin": {"const": "BOTTOMLEFT"}}}, "charspan": {"type": "array", "prefixItems": [{"type": "integer", "minimum": 0}, {"type": "integer", "minimum": 0}], "items": false}, "line_count": {"type": ["integer", "null"], "minimum": 1}, "left_pt": {"type": "number"}, "height_pt": {"type": "number", "exclusiveMinimum": 0}, "regime_id": {"type": "string", "pattern": "^reg-[a-f0-9]{16}$"}, "toc_region": {"type": "boolean"}, "numbering_kind": {"enum": ["none", "decimal", "article", "upper_alpha", "upper_roman", "bullet"]}, "numbering_token": {"type": ["string", "null"]}, "numbering_depth": {"type": ["integer", "null"], "minimum": 1}, "outline_state": {"enum": ["absent", "unique_exact", "ambiguous"]}, "outline_level": {"type": ["integer", "null"], "minimum": 1}, "layout_state": {"enum": ["absent", "unique_aligned", "ambiguous"]}, "printed_page_label": {"type": ["string", "null"]}}},
    "toc_entry": {"type": "object", "additionalProperties": false, "required": ["toc_entry_id", "source_item_keys", "reading_order_index", "physical_page", "bbox", "title_with_marker_normalized", "title_without_marker_normalized", "numbering_token", "depth", "depth_source", "printed_page", "parser_state", "boundary_eligible"], "properties": {"toc_entry_id": {"type": "string", "pattern": "^toc-[a-f0-9]{16}$"}, "source_item_keys": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/key"}, "uniqueItems": true}, "reading_order_index": {"type": "integer", "minimum": 0}, "physical_page": {"type": "integer", "minimum": 1}, "bbox": {"$ref": "#/$defs/bbox"}, "title_with_marker_normalized": {"type": "string", "minLength": 1}, "title_without_marker_normalized": {"type": "string", "minLength": 1}, "numbering_token": {"type": ["string", "null"]}, "depth": {"type": "integer", "minimum": 1}, "depth_source": {"enum": ["outline", "numbering", "default"]}, "printed_page": {"type": ["string", "null"]}, "parser_state": {"enum": ["complete", "missing_printed_page"]}, "boundary_eligible": {"const": false}}},
    "native_pdf_evidence": {"type": "object", "additionalProperties": false, "required": ["physical_page", "bbox", "normalized_text", "outline_ids"], "properties": {"physical_page": {"type": "integer", "minimum": 1}, "bbox": {"$ref": "#/$defs/bbox"}, "normalized_text": {"type": "string", "minLength": 1}, "outline_ids": {"type": "array", "maxItems": 1, "items": {"type": "string", "pattern": "^outline-[0-9]{8}$"}, "uniqueItems": true}}},
    "reconciliation": {"type": "object", "additionalProperties": false, "required": ["toc_entry_id", "reading_order_index", "state", "match_basis", "candidate_keys", "target_key", "target_evidence_keys", "native_pdf_evidence"], "properties": {"toc_entry_id": {"type": "string", "pattern": "^toc-[a-f0-9]{16}$"}, "reading_order_index": {"type": "integer", "minimum": 0}, "state": {"enum": ["exact", "missing", "ambiguous", "page_conflict", "level_conflict", "order_conflict"]}, "match_basis": {"enum": ["none", "strict_exact", "typographic_canonical", "composite_appendix", "multi_item_heading", "native_pdf_bbox_exact"]}, "candidate_keys": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true}, "target_key": {"anyOf": [{"$ref": "#/$defs/key"}, {"type": "null"}]}, "target_evidence_keys": {"type": "array", "items": {"$ref": "#/$defs/key"}, "uniqueItems": true}, "native_pdf_evidence": {"anyOf": [{"$ref": "#/$defs/native_pdf_evidence"}, {"type": "null"}]}}, "allOf": [{"if": {"properties": {"state": {"const": "exact"}}}, "then": {"properties": {"match_basis": {"not": {"const": "none"}}, "candidate_keys": {"minItems": 1, "maxItems": 1}, "target_key": {"$ref": "#/$defs/key"}, "target_evidence_keys": {"minItems": 1}}}, "else": {"properties": {"target_key": {"type": "null"}}}}, {"if": {"properties": {"state": {"const": "missing"}}}, "then": {"properties": {"match_basis": {"const": "none"}, "candidate_keys": {"maxItems": 0}, "target_evidence_keys": {"maxItems": 0}}}, "else": {"properties": {"match_basis": {"not": {"const": "none"}}, "target_evidence_keys": {"minItems": 1}}}}, {"if": {"properties": {"match_basis": {"const": "native_pdf_bbox_exact"}}}, "then": {"properties": {"native_pdf_evidence": {"$ref": "#/$defs/native_pdf_evidence"}}}, "else": {"properties": {"native_pdf_evidence": {"type": "null"}}}}]},
