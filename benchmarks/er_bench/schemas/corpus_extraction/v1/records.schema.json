{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/corpus-extraction/v1/records.schema.json",
  "title": "ER Commons restartable corpus extraction contract v1",
  "oneOf": [
    {"$ref": "#/$defs/contract_bundle"},
    {"$ref": "#/$defs/production_identity"}
  ],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "source_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_]*$"},
    "typed_id": {"type": "string", "pattern": "^(exv1|scopev1|txv1|docv1|idxv1|resv1|handoffv1)-[0-9a-f]{64}$"},
    "artifact_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "sha256", "pdf_page_count"],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "pdf_page_count": {"type": "integer", "minimum": 1}
      }
    },
    "contract_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "artifacts", "owned_code"],
      "properties": {
        "version": {"type": "string", "minLength": 1},
        "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}},
        "owned_code": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact_ref"}}
      }
    },
    "production_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "fixture_status", "execution_status", "extraction_id", "identity_sha256", "preimage"],
      "properties": {
        "record_type": {"const": "production_identity"},
        "schema_version": {"const": "er_commons.corpus_extraction_identity.v1"},
        "fixture_status": {"const": "identity_recipe"},
        "execution_status": {"const": "not_executed"},
        "extraction_id": {"type": "string", "pattern": "^exv1-[0-9a-f]{64}$"},
        "identity_sha256": {"$ref": "#/$defs/sha256"},
        "preimage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["schema_version", "extraction_version_name", "production_scope", "producer_contract", "canonical_contract", "hierarchy_contract", "cross_reference_contract", "corpus_workflow_contract"],
          "properties": {
            "schema_version": {"const": "er_commons.corpus_extraction_identity_preimage.v1"},
            "extraction_version_name": {"const": "brisbane_baylands_model_corpus_v1"},
            "production_scope": {
              "type": "object",
              "additionalProperties": false,
              "required": ["source_release_version", "source_manifest", "release_completion", "ordered_source_ids", "ordered_source_records_sha256"],
              "properties": {
                "source_release_version": {"const": "brisbane_baylands_2025_deir_sources_v1"},
                "source_manifest": {"$ref": "#/$defs/artifact_ref"},
                "release_completion": {"$ref": "#/$defs/artifact_ref"},
                "ordered_source_ids": {"type": "array", "minItems": 35, "maxItems": 35, "uniqueItems": true, "items": {"$ref": "#/$defs/source_id"}},
                "ordered_source_records_sha256": {"$ref": "#/$defs/sha256"}
              }
            },
            "producer_contract": {"$ref": "#/$defs/contract_ref"},
            "canonical_contract": {"$ref": "#/$defs/contract_ref"},
            "hierarchy_contract": {"$ref": "#/$defs/contract_ref"},
            "cross_reference_contract": {"$ref": "#/$defs/contract_ref"},
            "corpus_workflow_contract": {"$ref": "#/$defs/contract_ref"}
          }
        }
      }
    },
    "state_event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "transaction_id", "source_id", "attempt", "sequence", "from_state", "to_state", "raw_docling_status"],
      "properties": {
        "record_type": {"const": "document_state_event"},
        "schema_version": {"const": "er_commons.document_state_event.v1"},
        "transaction_id": {"type": "string", "pattern": "^txv1-[0-9a-f]{64}$"},
        "source_id": {"$ref": "#/$defs/source_id"},
        "attempt": {"type": "integer", "minimum": 1},
        "sequence": {"type": "integer", "minimum": 1},
        "from_state": {"type": ["string", "null"], "enum": [null, "selected", "running"]},
        "to_state": {"enum": ["selected", "running", "complete", "complete_with_warnings", "failed_retryable", "failed_terminal", "cancelled"]},
        "raw_docling_status": {"type": ["string", "null"], "enum": [null, "PENDING", "STARTED", "SUCCESS", "PARTIAL_SUCCESS", "FAILURE", "SKIPPED"]}
      }
    },
    "document_completion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "transaction_id", "source", "scope_kind", "processed_pages", "raw_docling_status", "candidate_id", "candidate_inventory", "completion_last"],
      "properties": {
        "record_type": {"const": "document_completion"},
        "schema_version": {"const": "er_commons.document_completion.v1"},
        "transaction_id": {"type": "string", "pattern": "^txv1-[0-9a-f]{64}$"},
        "source": {"$ref": "#/$defs/source"},
        "scope_kind": {"const": "full_document"},
        "processed_pages": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
        "raw_docling_status": {"const": "SUCCESS"},
        "candidate_id": {"type": "string", "pattern": "^docv1-[0-9a-f]{64}$"},
        "candidate_inventory": {"$ref": "#/$defs/artifact_ref"},
        "completion_last": {"const": true}
      }
    },
    "document_attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "transaction_id", "source_id", "attempt", "disposition", "failure_class", "message", "state_event_paths", "completion_path"],
      "properties": {
        "schema_version": {"const": "er_commons.document_attempt.v1"},
        "transaction_id": {"type": "string", "pattern": "^txv1-[0-9a-f]{64}$"},
        "source_id": {"$ref": "#/$defs/source_id"},
        "attempt": {"type": "integer", "minimum": 1},
        "disposition": {"enum": ["complete", "complete_with_warnings", "failed_retryable", "failed_terminal", "cancelled"]},
        "failure_class": {"type": ["string", "null"]},
        "message": {"type": ["string", "null"]},
        "state_event_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "completion_path": {"type": ["string", "null"]}
      }
    },
    "document_resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "transaction_id", "policy", "enforcement"],
      "properties": {
        "schema_version": {"const": "er_commons.document_resources.v1"},
        "transaction_id": {"type": "string", "pattern": "^txv1-[0-9a-f]{64}$"},
        "policy": {"type": "object"},
        "enforcement": {"const": "declared"}
      }
    },
    "document_resource_enforcement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "transaction_id", "enforcement"],
      "properties": {
        "schema_version": {"const": "er_commons.document_resource_enforcement.v1"},
        "transaction_id": {"type": "string", "pattern": "^txv1-[0-9a-f]{64}$"},
        "enforcement": {"const": "validated_before_content_owners"}
      }
    },
    "document_observability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "transaction_id", "wall_seconds", "peak_rss_bytes", "output_bytes", "stage_timings"],
      "properties": {
        "schema_version": {"const": "er_commons.document_observability.v1"},
        "transaction_id": {"type": "string", "pattern": "^txv1-[0-9a-f]{64}$"},
        "wall_seconds": {"type": "number", "minimum": 0},
        "peak_rss_bytes": {"type": ["integer", "null"], "minimum": 0},
        "output_bytes": {"type": "integer", "minimum": 0},
        "stage_timings": {
          "type": "object",
          "additionalProperties": {"type": "number", "minimum": 0}
        }
      }
    },
    "accounting_row": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_id", "terminal_state", "transaction_id", "candidate_id"],
      "properties": {
        "source_id": {"$ref": "#/$defs/source_id"},
        "terminal_state": {"enum": ["complete", "complete_with_warnings", "failed_terminal"]},
        "transaction_id": {"type": "string", "pattern": "^txv1-[0-9a-f]{64}$"},
        "candidate_id": {"type": ["string", "null"], "pattern": "^docv1-[0-9a-f]{64}$"}
      }
    },
    "scope_accounting": {
      "type": "object",
      "additionalProperties": false,
      "required": ["record_type", "schema_version", "scope_id", "scope_kind", "production_extraction_id", "ordered_sources", "rows", "counts", "status"],
      "properties": {
        "record_type": {"const": "scope_accounting"},
        "schema_version": {"const": "er_commons.scope_accounting.v1"},
        "scope_id": {"type": "string", "pattern": "^scopev1-[0-9a-f]{64}$"},
        "scope_kind": {"enum": ["fixture", "engineering_smoke", "representative_pilot", "production_full"]},
        "production_extraction_id": {"type": "string", "pattern": "^exv1-[0-9a-f]{64}$"},
        "ordered_sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
        "rows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/accounting_row"}},
        "counts": {
          "type": "object", "additionalProperties": false,
          "required": ["total", "complete", "complete_with_warnings", "failed_terminal"],
          "properties": {"total": {"type": "integer", "minimum": 1}, "complete": {"type": "integer", "minimum": 0}, "complete_with_warnings": {"type": "integer", "minimum": 0}, "failed_terminal": {"type": "integer", "minimum": 0}}
        },
        "status": {"const": "complete"}
      }
    },
    "target_index_entry": {
      "type": "object", "additionalProperties": false,
      "required": ["alias_id", "lookup_key", "target_type", "source_id", "source_ordinal", "target_id"],
      "properties": {
        "alias_id": {"type": "string", "minLength": 1},
        "lookup_key": {"type": "string", "minLength": 1},
        "target_type": {"enum": ["document", "section", "page", "table", "figure"]},
        "source_id": {"$ref": "#/$defs/source_id"},
        "source_ordinal": {"type": "integer", "minimum": 1},
        "target_id": {"type": "string", "minLength": 1}
      }
    },
    "target_index": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "schema_version", "index_id", "eligible_candidate_ids", "unavailable_source_ids", "entries", "entries_sha256", "status"],
      "properties": {
        "record_type": {"const": "target_index_completion"},
        "schema_version": {"const": "er_commons.target_index_completion.v1"},
        "index_id": {"type": "string", "pattern": "^idxv1-[0-9a-f]{64}$"},
        "eligible_candidate_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^docv1-[0-9a-f]{64}$"}},
        "unavailable_source_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source_id"}},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/target_index_entry"}},
        "entries_sha256": {"$ref": "#/$defs/sha256"},
        "status": {"const": "complete"}
      }
    },
    "resolution": {
      "type": "object", "additionalProperties": false,
      "required": ["mention_id", "source_candidate_id", "source_inventory_before", "source_inventory_after", "lookup_key", "candidate_target_ids", "status", "unresolved_reason"],
      "properties": {
        "mention_id": {"type": "string", "minLength": 1},
        "source_candidate_id": {"type": "string", "pattern": "^docv1-[0-9a-f]{64}$"},
        "source_inventory_before": {"$ref": "#/$defs/sha256"},
        "source_inventory_after": {"$ref": "#/$defs/sha256"},
        "lookup_key": {"type": "string", "minLength": 1},
        "candidate_target_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "status": {"enum": ["resolved", "ambiguous", "unresolved"]},
        "unresolved_reason": {"type": ["string", "null"], "enum": [null, "target_not_in_scope", "target_source_failed", "target_unavailable"]}
      }
    },
    "resolution_completion": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "schema_version", "resolution_id", "index_id", "eligible_mention_ids", "resolutions", "counts", "status"],
      "properties": {
        "record_type": {"const": "resolution_completion"},
        "schema_version": {"const": "er_commons.resolution_completion.v1"},
        "resolution_id": {"type": "string", "pattern": "^resv1-[0-9a-f]{64}$"},
        "index_id": {"type": "string", "pattern": "^idxv1-[0-9a-f]{64}$"},
        "eligible_mention_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "resolutions": {"type": "array", "items": {"$ref": "#/$defs/resolution"}},
        "counts": {
          "type": "object", "additionalProperties": false,
          "required": ["total", "resolved", "ambiguous", "unresolved"],
          "properties": {"total": {"type": "integer", "minimum": 0}, "resolved": {"type": "integer", "minimum": 0}, "ambiguous": {"type": "integer", "minimum": 0}, "unresolved": {"type": "integer", "minimum": 0}}
        },
        "status": {"const": "complete"}
      }
    },
    "handoff": {
      "type": "object", "additionalProperties": false,
      "required": ["record_type", "schema_version", "handoff_id", "scope_id", "index_id", "resolution_id", "blocking_policy", "status", "task04_status"],
      "properties": {
        "record_type": {"const": "candidate_handoff"},
        "schema_version": {"const": "er_commons.candidate_handoff.v1"},
        "handoff_id": {"type": "string", "pattern": "^handoffv1-[0-9a-f]{64}$"},
        "scope_id": {"type": "string", "pattern": "^scopev1-[0-9a-f]{64}$"},
        "index_id": {"type": "string", "pattern": "^idxv1-[0-9a-f]{64}$"},
        "resolution_id": {"type": "string", "pattern": "^resv1-[0-9a-f]{64}$"},
        "blocking_policy": {"enum": ["all_sources_successful", "terminal_failures_allowed"]},
        "status": {"enum": ["ready", "blocked"]},
        "task04_status": {"const": "not_evaluated"}
      }
    },
    "resource_policy": {
      "type": "object", "additionalProperties": false,
      "required": ["document_concurrency", "page_batch_size", "cpu_threads_per_document", "device", "docling_timeout_seconds", "outer_process_deadline_seconds", "retry_limit"],
      "properties": {
        "document_concurrency": {"type": "integer", "minimum": 1, "maximum": 4},
        "page_batch_size": {"type": "integer", "minimum": 1, "maximum": 32},
        "cpu_threads_per_document": {"type": "integer", "minimum": 1, "maximum": 16},
        "device": {"enum": ["cpu", "mps", "cuda", "auto"]},
        "docling_timeout_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "outer_process_deadline_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
        "retry_limit": {"type": "integer", "minimum": 0, "maximum": 5}
      }
    },
    "contract_bundle": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "fixture_scope", "production_extraction_id", "resource_policy", "state_events", "document_completions", "accounting", "target_index", "resolution_completion", "handoff", "task04_freezes"],
      "properties": {
        "schema_version": {"const": "er_commons.corpus_extraction_contract_fixture.v1"},
        "fixture_scope": {"const": "synthetic_multi_document"},
        "production_extraction_id": {"type": "string", "pattern": "^exv1-[0-9a-f]{64}$"},
        "resource_policy": {"$ref": "#/$defs/resource_policy"},
        "state_events": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/state_event"}},
        "document_completions": {"type": "array", "items": {"$ref": "#/$defs/document_completion"}},
        "accounting": {"$ref": "#/$defs/scope_accounting"},
        "target_index": {"$ref": "#/$defs/target_index"},
        "resolution_completion": {"$ref": "#/$defs/resolution_completion"},
        "handoff": {"$ref": "#/$defs/handoff"},
        "task04_freezes": {"type": "array", "maxItems": 0}
      }
    }
  }
}
