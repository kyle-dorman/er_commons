        "blocking_policy": {
          "enum": ["all_sources_successful", "terminal_failures_allowed"]
        },
        "blocking_policy_ref": {"$ref": "#/$defs/artifact_ref"},
        "blocking_reasons": {
          "type": "array",
          "items": {"$ref": "#/$defs/handoff_blocking_reason"}
        },
        "status": {"enum": ["ready", "blocked"]},
        "task04_status": {"const": "not_evaluated"},
        "artifact_inventory": {"$ref": "#/$defs/artifact_ref"},
        "completion_last": {"const": true}
      },
      "allOf": [
        {
          "if": {
            "properties": {"status": {"const": "ready"}},
            "required": ["status"]
          },
          "then": {"properties": {"blocking_reasons": {"maxItems": 0}}},
          "else": {"properties": {"blocking_reasons": {"minItems": 1}}}
        },
        {
          "if": {
            "properties": {
              "blocking_policy": {"const": "terminal_failures_allowed"}
            },
            "required": ["blocking_policy"]
          },
          "then": {
            "properties": {
              "status": {"const": "ready"},
              "blocking_reasons": {"maxItems": 0}
            }
          }
        }
      ]
