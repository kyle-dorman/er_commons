        "completion_last",
        "status"
      ],
      "properties": {
        "record_type": {"const": "resolution_completion"},
        "schema_version": {"const": "er_commons.resolution_completion.v1_1"},
        "resolution_id": {"type": "string", "pattern": "^resv1-[0-9a-f]{64}$"},
        "index_id": {"type": "string", "pattern": "^idxv1-[0-9a-f]{64}$"},
        "identity_preimage": {"$ref": "#/$defs/resolution_identity_preimage"},
        "identity_preimage_ref": {"$ref": "#/$defs/artifact_ref"},
        "index_completion_ref": {"$ref": "#/$defs/artifact_ref"},
        "mention_input_manifest": {"$ref": "#/$defs/mention_input_manifest"},
        "mention_input_manifest_ref": {"$ref": "#/$defs/artifact_ref"},
        "resolutions": {
          "type": "array",
          "items": {"$ref": "#/$defs/resolution"}
        },
        "resolutions_ref": {"$ref": "#/$defs/artifact_ref"},
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["total", "resolved", "ambiguous", "unresolved"],
          "properties": {
            "total": {"type": "integer", "minimum": 0},
            "resolved": {"type": "integer", "minimum": 0},
            "ambiguous": {"type": "integer", "minimum": 0},
            "unresolved": {"type": "integer", "minimum": 0}
          }
        },
        "candidate_inventories_before": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate_inventory_snapshot"}
        },
        "candidate_inventories_after": {
          "type": "array",
          "items": {"$ref": "#/$defs/candidate_inventory_snapshot"}
        },
        "artifact_inventory": {"$ref": "#/$defs/artifact_ref"},
        "completion_last": {"const": true},
        "status": {"const": "complete"}
      }
