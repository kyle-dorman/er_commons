{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "qualification_only",
    "advancing_claim_ids",
    "records",
    "pending_task_ids",
    "project_id",
    "export_lineage",
    "native_export_sha256",
    "schema_version",
    "advancing_case_ids",
    "allowed_next_stage"
  ],
  "additionalProperties": false,
  "properties": {
    "qualification_only": {
      "const": true
    },
    "advancing_claim_ids": {
      "type": "array",
      "maxItems": 0
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "pending_task_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "project_id": {
      "type": "integer",
      "minimum": 1
    },
    "export_lineage": {
      "type": "string",
      "minLength": 1
    },
    "native_export_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "schema_version": {
      "const": "er_commons.task08e.qualification_export.v1"
    },
    "advancing_case_ids": {
      "type": "array",
      "maxItems": 0
    },
    "allowed_next_stage": {
      "type": "null"
    }
  }
}
