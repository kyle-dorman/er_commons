{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Task08E investigation evidence review export; eligibility remains separate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "qualification_only", "records", "pending_task_ids", "project_id", "reviewer_id", "export_lineage", "native_export_sha256", "advancing_case_ids", "advancing_claim_ids", "allowed_next_stage", "eligibility"],
  "properties": {
    "schema_version": {"const": "er_commons.task08e.evidence_export.v2"},
    "qualification_only": {"const": false},
    "records": {"type": "array", "items": {"type": "object", "required": ["claim_id", "case_id", "packet_sha256", "task_id", "annotation_id", "reviewer", "claim_review", "upstream_case", "upstream_handoff_sha256", "native_annotation", "annotation_sha256", "shared_form_sha256", "interface_version", "qualification_only"], "properties": {"interface_version": {"const": "task08e.evidence_review.v2"}, "qualification_only": {"const": false}}}},
    "pending_task_ids": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1}},
    "project_id": {"type": "integer", "minimum": 1},
    "reviewer_id": {"type": ["integer", "string"]},
    "export_lineage": {"type": "string", "minLength": 1},
    "native_export_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "advancing_case_ids": {"const": []},
    "advancing_claim_ids": {"const": []},
    "allowed_next_stage": {"type": "null"},
    "eligibility": {"const": "undecided"}
  }
}
