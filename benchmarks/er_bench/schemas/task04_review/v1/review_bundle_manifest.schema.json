{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/task04_review/v1/review_bundle_manifest.schema.json",
  "title": "ER Commons Task 04 review bundle manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "review_run_id",
    "pass",
    "status",
    "selection_manifest_sha256",
    "identity",
    "render",
    "package_versions",
    "mutable_records",
    "render_bindings",
    "files"
  ],
  "properties": {
    "schema_version": {"const": "er_commons.task04_review.v1.review_bundle_manifest"},
    "review_run_id": {"$ref": "#/$defs/review_run_id"},
    "pass": {"const": "task03h_first"},
    "status": {"const": "generated_disposable_bundle"},
    "selection_manifest_sha256": {"$ref": "#/$defs/digest"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input_sha256",
        "policy_sha256",
        "implementation_sha256",
        "dependencies",
        "selected_sources"
      ],
      "properties": {
        "input_sha256": {"$ref": "#/$defs/digest"},
        "policy_sha256": {"$ref": "#/$defs/digest"},
        "implementation_sha256": {"$ref": "#/$defs/digest"},
        "dependencies": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/dependency"}
        },
        "selected_sources": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_id", "source_pdf_sha256", "candidate_id", "completion_sha256", "inventory_sha256"],
            "properties": {
              "source_id": {"type": "string", "minLength": 1},
              "source_pdf_sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
              "candidate_id": {"type": "string", "pattern": "^docv1-[a-f0-9]+$"},
              "completion_sha256": {"$ref": "#/$defs/digest"},
              "inventory_sha256": {"$ref": "#/$defs/digest"}
            }
          }
        }
      }
    },
    "render": {
      "type": "object",
      "additionalProperties": false,
      "required": ["renderer", "renderer_version", "scale", "rendered_page_count"],
      "properties": {
        "renderer": {"type": "string", "minLength": 1},
        "renderer_version": {"type": "string", "minLength": 1},
        "scale": {"type": "number", "exclusiveMinimum": 0},
        "rendered_page_count": {"type": "integer", "minimum": 0}
      }
    },
    "package_versions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "mutable_records": {
      "const": [
        "records/finding_register.json",
        "records/task03i_handoff.json"
      ]
    },
    "render_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["review_item_id", "pages"],
        "properties": {
          "review_item_id": {"type": "string", "pattern": "^reviewitem-[a-f0-9]{24}$"},
          "pages": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["physical_page", "path"],
              "properties": {
                "physical_page": {"type": "integer", "minimum": 1},
                "path": {"$ref": "#/$defs/relative_path"}
              }
            }
          }
        }
      }
    },
    "files": {"type": "array", "items": {"$ref": "#/$defs/file"}}
  },
  "$defs": {
    "digest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "review_run_id": {"type": "string", "pattern": "^reviewv1-task03h-first-[a-f0-9]{16}$"},
    "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "byte_size"],
      "properties": {
        "path": {"$ref": "#/$defs/relative_path"},
        "sha256": {"$ref": "#/$defs/digest"},
        "byte_size": {"type": "integer", "minimum": 0}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "path", "sha256", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {
          "enum": [
            "maintained_code_tree",
            "maintained_code_file",
            "asset_tree",
            "schema_tree",
            "package"
          ]
        },
        "path": {"oneOf": [{"$ref": "#/$defs/relative_path"}, {"type": "null"}]},
        "sha256": {"oneOf": [{"$ref": "#/$defs/digest"}, {"type": "null"}]},
        "version": {"type": ["string", "null"]}
      }
    }
  }
}
