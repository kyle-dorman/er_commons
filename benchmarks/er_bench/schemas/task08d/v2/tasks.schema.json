{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "data": {
        "type": "object",
        "properties": {
          "form_version": {
            "const": "task08d.claim_review.v2"
          },
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "question": {
            "type": "object",
            "properties": {
              "text": {
                "type": "string",
                "minLength": 1
              },
              "text_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "question_id": {
                "type": "string",
                "minLength": 1
              },
              "question_version": {
                "type": "string",
                "minLength": 1
              },
              "approval": {
                "type": "object"
              },
              "comment_id": {
                "type": "string",
                "minLength": 1
              },
              "original_comment_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              },
              "comment_text_sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": [
              "text",
              "text_sha256",
              "question_id",
              "question_version",
              "approval",
              "comment_id",
              "original_comment_sha256",
              "comment_text_sha256"
            ],
            "additionalProperties": true
          },
          "packet_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "proposal_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "case_input": {
            "type": "object",
            "properties": {
              "case_id": {
                "type": "string",
                "minLength": 1
              },
              "question": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "text_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "question_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "question_version": {
                    "type": "string",
                    "minLength": 1
                  },
                  "approval": {
                    "type": "object"
                  },
                  "comment_id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "original_comment_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  },
                  "comment_text_sha256": {
                    "type": "string",
                    "pattern": "^[a-f0-9]{64}$"
                  }
                },
                "required": [
                  "text",
                  "text_sha256",
                  "question_id",
                  "question_version",
                  "approval",
                  "comment_id",
                  "original_comment_sha256",
                  "comment_text_sha256"
                ],
                "additionalProperties": true
              },
              "original_comment": {
                "type": "object"
              },
              "responses": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "passages": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "passage_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "unit_id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "start": {
                      "type": "integer",
                      "minimum": 0
                    },
                    "end": {
                      "type": "integer",
                      "minimum": 1
                    },
                    "text": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "passage_id",
                    "unit_id",
                    "start",
                    "end",
                    "text"
                  ],
                  "additionalProperties": false
                }
              },
              "closure": {
                "type": "object"
              },
              "supplements": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "outcomes": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "warnings": {}
            },
            "required": [
              "case_id",
              "question",
              "original_comment",
              "responses",
              "passages",
              "closure",
              "supplements",
              "outcomes",
              "warnings"
            ],
            "additionalProperties": false
          },
          "proposal": {
            "type": "object"
          },
          "slot_bindings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slot": {
                  "type": "string",
                  "minLength": 1
                },
                "claim_id": {
                  "type": "string",
                  "minLength": 1
                },
                "proposal_claim_id": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "slot",
                "claim_id",
                "proposal_claim_id"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "form_version",
          "case_id",
          "question",
          "packet_sha256",
          "proposal_sha256",
          "case_input",
          "proposal",
          "slot_bindings"
        ],
        "additionalProperties": true
      },
      "predictions": {
        "type": "array",
        "items": {
          "type": "object"
        }
      }
    },
    "required": [
      "data",
      "predictions"
    ],
    "additionalProperties": false
  }
}
