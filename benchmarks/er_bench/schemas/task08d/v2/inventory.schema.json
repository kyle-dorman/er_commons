{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "task08d.inventory.v1"
    },
    "model": {
      "const": "gpt-6-astra"
    },
    "packet_sha256": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "assertions": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "assertion_id": {
                  "type": "string",
                  "minLength": 1
                },
                "text": {
                  "type": "string",
                  "minLength": 1
                },
                "passage_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                }
              },
              "required": [
                "assertion_id",
                "text",
                "passage_ids"
              ],
              "additionalProperties": false
            }
          },
          "passage_coverage": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "passage_id": {
                  "type": "string",
                  "minLength": 1
                },
                "assertion_ids": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "passage_id",
                "assertion_ids",
                "note"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "case_id",
          "assertions",
          "passage_coverage"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "model",
    "packet_sha256",
    "cases"
  ],
  "additionalProperties": false
}
