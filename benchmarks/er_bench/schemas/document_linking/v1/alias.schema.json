{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/document_linking/v1/alias.schema.json",
  "title": "Document link target alias row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "document_id",
    "sequence",
    "alias_kind",
    "raw_values",
    "normalized_alias",
    "normalization_policy",
    "resolution_status",
    "alias_origin",
    "upstream_alias_id",
    "targets"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "alias_kind": {
      "enum": [
        "document",
        "appendix",
        "section",
        "table",
        "figure",
        "printed_page"
      ]
    },
    "raw_values": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "normalized_alias": {
      "type": "string",
      "minLength": 1
    },
    "normalization_policy": {
      "type": "string",
      "minLength": 1
    },
    "resolution_status": {
      "enum": [
        "unique",
        "ambiguous"
      ]
    },
    "alias_origin": {
      "enum": [
        "upstream_v2",
        "v3_verified_table_label",
        "linking_v1_r6_body_table_caption"
      ]
    },
    "upstream_alias_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target_id",
          "target_type",
          "upstream_target_id",
          "evidence_kind",
          "evidence_source_record_id",
          "evidence_page_id"
        ],
        "properties": {
          "target_id": {
            "type": "string",
            "minLength": 1
          },
          "target_type": {
            "enum": [
              "section",
              "table",
              "figure",
              "page",
              "document"
            ]
          },
          "upstream_target_id": {
            "type": "string",
            "minLength": 1
          },
          "evidence_kind": {
      "enum": [
        "accepted_v2_alias",
        "verified_same_page_table_label",
        "r6_body_table_caption"
      ]
          },
          "evidence_source_record_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_page_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    }
  }
}
