{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/document_linking/v1/navigation_link.schema.json",
  "title": "Navigation link row v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "extraction_id",
    "source_id",
    "navigation_entry_id",
    "sequence",
    "target_id",
    "supporting_alias_ids",
    "target_page_ids",
    "match_basis"
  ],
  "properties": {
    "schema_version": {
      "const": "er_commons.navigation_link.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "extraction_id": {
      "type": "string",
      "pattern": "^exv1-[0-9a-f]{64}$"
    },
    "source_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "navigation_entry_id": {
      "type": "string",
      "minLength": 1
    },
    "sequence": {
      "type": "integer",
      "minimum": 1
    },
    "target_id": {
      "type": "string",
      "minLength": 1
    },
    "supporting_alias_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "target_page_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "match_basis": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  }
}
