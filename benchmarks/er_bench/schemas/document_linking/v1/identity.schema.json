{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/document_linking/v1/identity.schema.json",
  "title": "Document link identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_version_name",
    "extraction_id",
    "identity_sha256",
    "document_link_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "er_commons.extraction_identity.v3"
    },
    "extraction_version_name": {
      "const": "document_linking_v1"
    },
    "extraction_id": {
      "$ref": "#/$defs/extractionId"
    },
    "identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "document_link_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_id",
        "source_document_id",
        "structured_candidate_id",
        "source_document_completion_sha256",
        "source_document_inventory_sha256",
        "structured_completion_sha256",
        "structured_inventory_sha256",
        "link_run_spec_sha256",
        "linking_policy_sha256",
        "source_family_catalog_sha256",
        "reviewed_navigation_bundle_id",
        "reviewed_navigation_completion_sha256",
        "output_schema_bundle_sha256",
        "owned_code_bundle_sha256"
      ],
      "properties": {
        "schema_version": {
          "enum": [
            "er_commons.document_link_identity.v1",
            "er_commons.document_link_identity.v2"
          ]
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_document_id": {
          "type": "string",
          "pattern": "^docv1-[0-9a-f]{64}$"
        },
        "structured_candidate_id": {
          "$ref": "#/$defs/extractionId"
        },
        "source_document_completion_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_document_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "structured_completion_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "structured_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "link_run_spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "linking_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_family_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewed_navigation_bundle_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^navreviewv1-[0-9a-f]{64}$"
        },
        "reviewed_navigation_completion_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_schema_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owned_code_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "resolved_spec_ref": {
          "$ref": "#/$defs/authorityRef"
        },
        "accepted_fc1_evidence": {
          "$ref": "#/$defs/acceptedFc1Evidence"
        },
        "fc1_rebuilt_equivalence_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reviewed_navigation_bundle_id": {
                "type": "null"
              }
            },
            "required": [
              "reviewed_navigation_bundle_id"
            ]
          },
          "then": {
            "properties": {
              "reviewed_navigation_completion_sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reviewed_navigation_completion_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "schema_version": {"const": "er_commons.document_link_identity.v2"}
            }
          },
          "then": {"required": ["resolved_spec_ref"]},
          "else": {"properties": {"resolved_spec_ref": false}}
        },
        {
          "if": {
            "properties": {
              "schema_version": {"const": "er_commons.document_link_identity.v2"},
              "source_id": {"const": "deir_main"}
            },
            "required": ["schema_version", "source_id"]
          },
          "then": {"required": ["accepted_fc1_evidence", "fc1_rebuilt_equivalence_sha256"]},
          "else": {"properties": {"accepted_fc1_evidence": false, "fc1_rebuilt_equivalence_sha256": false}}
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "extractionId": {
      "type": "string",
      "pattern": "^exv1-[0-9a-f]{64}$"
    },
    "authorityRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "path", "sha256", "byte_size"],
      "properties": {
        "authority": {"enum": ["repository", "artifact_root"]},
        "path": {"type": "string", "minLength": 1, "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "byte_size": {"type": "integer", "minimum": 0}
      }
    },
    "acceptedFc1Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualification_id", "source_id", "completion_ref", "inventory_ref", "identity_ref", "qualification_ref", "figure_aliases_ref", "target_index_entries_ref"],
      "properties": {
        "qualification_id": {"type": "string", "pattern": "^figqualv1-[0-9a-f]{64}$"},
        "source_id": {"const": "deir_main"},
        "completion_ref": {"$ref": "#/$defs/authorityRef"},
        "inventory_ref": {"$ref": "#/$defs/authorityRef"},
        "identity_ref": {"$ref": "#/$defs/authorityRef"},
        "qualification_ref": {"$ref": "#/$defs/authorityRef"},
        "figure_aliases_ref": {"$ref": "#/$defs/authorityRef"},
        "target_index_entries_ref": {"$ref": "#/$defs/authorityRef"}
      }
    }
  }
}
