{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/document_linking/v1/identity.schema.json",
  "title": "Document link identity v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "extraction_version_name",
    "extraction_id",
    "identity_sha256",
    "document_link_contract"
  ],
  "properties": {
    "schema_version": {
      "const": "er_commons.extraction_identity.v3"
    },
    "extraction_version_name": {
      "const": "document_linking_v1"
    },
    "extraction_id": {
      "$ref": "#/$defs/extractionId"
    },
    "identity_sha256": {
      "$ref": "#/$defs/sha256"
    },
    "document_link_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema_version",
        "source_id",
        "source_document_id",
        "structured_candidate_id",
        "source_document_completion_sha256",
        "source_document_inventory_sha256",
        "structured_completion_sha256",
        "structured_inventory_sha256",
        "link_run_spec_sha256",
        "linking_policy_sha256",
        "source_family_catalog_sha256",
        "reviewed_navigation_bundle_id",
        "reviewed_navigation_completion_sha256",
        "output_schema_bundle_sha256",
        "owned_code_bundle_sha256"
      ],
      "properties": {
        "schema_version": {
          "const": "er_commons.document_link_identity.v1"
        },
        "source_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "source_document_id": {
          "type": "string",
          "pattern": "^docv1-[0-9a-f]{64}$"
        },
        "structured_candidate_id": {
          "$ref": "#/$defs/extractionId"
        },
        "source_document_completion_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_document_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "structured_completion_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "structured_inventory_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "link_run_spec_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "linking_policy_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "source_family_catalog_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "reviewed_navigation_bundle_id": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^navreviewv1-[0-9a-f]{64}$"
        },
        "reviewed_navigation_completion_sha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "output_schema_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        },
        "owned_code_bundle_sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "reviewed_navigation_bundle_id": {
                "type": "null"
              }
            },
            "required": [
              "reviewed_navigation_bundle_id"
            ]
          },
          "then": {
            "properties": {
              "reviewed_navigation_completion_sha256": {
                "type": "null"
              }
            }
          },
          "else": {
            "properties": {
              "reviewed_navigation_completion_sha256": {
                "$ref": "#/$defs/sha256"
              }
            }
          }
        }
      ]
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "extractionId": {
      "type": "string",
      "pattern": "^exv1-[0-9a-f]{64}$"
    }
  }
}
