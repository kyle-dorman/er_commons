{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/document_linking/v1/document_link_run.schema.json",
  "title": "Document link run specification v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_relative_root",
    "base_collection",
    "base_production_identity_ref",
    "replacement_production_identity_recipe_ref",
    "document_publication_spec_ref",
    "collection_run_spec_ref",
    "linking_policy_ref",
    "linking_policy_schema_ref",
    "source_family_catalog_ref",
    "selected_source_ids",
    "documents",
    "reviewed_navigation",
    "output_schema_refs"
  ],
  "properties": {
    "schema_version": {"enum": ["er_commons.document_link_run_spec.v1", "er_commons.document_link_run_spec.v2"]},
    "resolution_status": {"enum": ["template", "resolved"]},
    "artifact_relative_root": {"$ref": "#/$defs/relativePath"},
    "base_collection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["handoff_ref", "contract_bundle_ref"],
      "properties": {
        "handoff_ref": {"$ref": "#/$defs/artifactRef"},
        "contract_bundle_ref": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "base_membership_ref": {"$ref": "#/$defs/artifactRef"},
    "base_production_identity_ref": {"$ref": "#/$defs/artifactRef"},
    "replacement_production_identity_recipe_ref": {"$ref": "#/$defs/artifactRef"},
    "document_publication_spec_ref": {"$ref": "#/$defs/artifactRef"},
    "collection_run_spec_ref": {"$ref": "#/$defs/artifactRef"},
    "linking_policy_ref": {"$ref": "#/$defs/artifactRef"},
    "linking_policy_schema_ref": {"$ref": "#/$defs/artifactRef"},
    "source_family_catalog_ref": {"$ref": "#/$defs/artifactRef"},
    "selected_source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "figure_alias_source_ids": {
      "type": "array",
      "prefixItems": [{"const": "deir_main"}],
      "minItems": 1,
      "maxItems": 1
    },
    "accepted_fc1_evidence": {"$ref": "#/$defs/acceptedFc1Evidence"},
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source_id", "source_document", "structured_document"],
        "properties": {
          "source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "source_document": {"$ref": "#/$defs/sealedDocumentCandidate"},
          "structured_document": {"$ref": "#/$defs/sealedStructuredCandidate"},
          "logical_source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "base_source_id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "base_source_document": {"$ref": "#/$defs/sealedDocumentCandidate"},
          "base_structured_document": {"$ref": "#/$defs/sealedStructuredCandidate"},
          "change_class": {"enum": ["preserved_semantic", "new_source_addition_no_old_entity_equivalence", "repeated_heading_many_to_one", "missing_chapter_additions_and_fc1_aliases"]},
          "reuse_basis": {"enum": ["sealed_base_candidate_downstream_replay", "qualified_substitute_new_source_no_entity_equivalence", "accepted_repeated_heading_repair", "accepted_missing_chapter_and_fc1_repair"]},
          "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}},
          "correspondence_refs": {"type": "array", "items": {"$ref": "#/$defs/artifactRef"}}
        }
      }
    },
    "reviewed_navigation": {
      "oneOf": [
        {"type": "null"},
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "bundle_id",
            "bundle_ref",
            "schema_ref",
            "source_ids",
            "identity_ref",
            "completion_ref",
            "inventory_ref",
            "review_decisions_ref",
            "semantic_view_ref",
            "disposition_ref",
            "text_entries_ref",
            "parent_relations_ref"
          ],
          "properties": {
            "bundle_id": {"type": "string", "pattern": "^navreviewv1-[0-9a-f]{64}$"},
            "bundle_ref": {"$ref": "#/$defs/artifactRef"},
            "schema_ref": {"$ref": "#/$defs/artifactRef"},
            "source_ids": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
            },
            "identity_ref": {"$ref": "#/$defs/artifactRef"},
            "completion_ref": {"$ref": "#/$defs/artifactRef"},
            "inventory_ref": {"$ref": "#/$defs/artifactRef"},
            "review_decisions_ref": {"$ref": "#/$defs/artifactRef"},
            "semantic_view_ref": {"$ref": "#/$defs/artifactRef"},
            "disposition_ref": {"$ref": "#/$defs/bundleRef"},
            "text_entries_ref": {"$ref": "#/$defs/bundleRef"},
            "parent_relations_ref": {"$ref": "#/$defs/bundleRef"}
          }
        }
      ]
    },
    "output_schema_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["identity", "manifest", "inventory", "completion", "alias", "ordinary_reference", "navigation_entry", "navigation_relation", "navigation_decision", "navigation_link", "support"],
      "properties": {
        "identity": {"$ref": "#/$defs/artifactRef"},
        "manifest": {"$ref": "#/$defs/artifactRef"},
        "inventory": {"$ref": "#/$defs/artifactRef"},
        "completion": {"$ref": "#/$defs/artifactRef"},
        "alias": {"$ref": "#/$defs/artifactRef"},
        "ordinary_reference": {"$ref": "#/$defs/artifactRef"},
        "navigation_entry": {"$ref": "#/$defs/artifactRef"},
        "navigation_relation": {"$ref": "#/$defs/artifactRef"},
        "navigation_decision": {"$ref": "#/$defs/artifactRef"},
        "navigation_link": {"$ref": "#/$defs/artifactRef"},
        "support": {"$ref": "#/$defs/artifactRef"}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "er_commons.document_link_run_spec.v2"}}},
      "then": {
        "required": ["figure_alias_source_ids", "accepted_fc1_evidence", "base_membership_ref", "resolution_status"]
      },
      "else": {"properties": {"figure_alias_source_ids": false, "accepted_fc1_evidence": false, "base_membership_ref": false, "resolution_status": false}}
    }
  ],
  "$defs": {
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "artifactRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "path", "sha256", "byte_size"],
      "properties": {
        "authority": {"enum": ["repository", "artifact_root"]},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    },
    "acceptedFc1Evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["qualification_id", "source_id", "completion_ref", "inventory_ref", "identity_ref", "qualification_ref", "figure_aliases_ref", "target_index_entries_ref"],
      "properties": {
        "qualification_id": {"type": "string", "pattern": "^figqualv1-[0-9a-f]{64}$"},
        "source_id": {"const": "deir_main"},
        "completion_ref": {"$ref": "#/$defs/artifactRef"},
        "inventory_ref": {"$ref": "#/$defs/artifactRef"},
        "identity_ref": {"$ref": "#/$defs/artifactRef"},
        "qualification_ref": {"$ref": "#/$defs/artifactRef"},
        "figure_aliases_ref": {"$ref": "#/$defs/artifactRef"},
        "target_index_entries_ref": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "bundleRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authority", "path", "sha256", "byte_size"],
      "properties": {
        "authority": {"const": "bundle"},
        "path": {"$ref": "#/$defs/relativePath"},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "byte_size": {"type": "integer", "minimum": 1}
      }
    },
    "sealedDocumentCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "completion_ref", "inventory_ref"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^docv1-[0-9a-f]{64}$"},
        "completion_ref": {"$ref": "#/$defs/artifactRef"},
        "inventory_ref": {"$ref": "#/$defs/artifactRef"}
      }
    },
    "sealedStructuredCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "completion_ref", "inventory_ref"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^exv1-[0-9a-f]{64}$"},
        "completion_ref": {"$ref": "#/$defs/artifactRef"},
        "inventory_ref": {"$ref": "#/$defs/artifactRef"}
      }
    }
  }
}
