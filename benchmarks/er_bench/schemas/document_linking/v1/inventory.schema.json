{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/document_linking/v1/inventory.schema.json",
  "title": "Document link artifact inventory v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "files",
    "file_count",
    "byte_size"
  ],
  "properties": {
    "schema_version": {
      "const": "er_commons.candidate_artifact_inventory.v1"
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "sha256",
          "byte_size"
        ],
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "byte_size": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "file_count": {
      "type": "integer",
      "minimum": 0
    },
    "byte_size": {
      "type": "integer",
      "minimum": 0
    }
  }
}
