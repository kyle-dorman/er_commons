{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://er-commons.local/schemas/document_linking/v2/alias.schema.json",
  "title": "Document link target alias row v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "document_id",
    "sequence",
    "alias_kind",
    "raw_values",
    "normalized_alias",
    "normalization_policy",
    "resolution_status",
    "alias_origin",
    "upstream_alias_id",
    "targets"
  ],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "document_id": {"type": "string", "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "alias_kind": {
      "enum": ["document", "appendix", "section", "table", "figure", "printed_page"]
    },
    "raw_values": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string"}
    },
    "normalized_alias": {"type": "string", "minLength": 1},
    "normalization_policy": {"type": "string", "minLength": 1},
    "resolution_status": {"enum": ["unique", "ambiguous"]},
    "alias_origin": {
      "enum": [
        "upstream_v2",
        "v3_verified_table_label",
        "linking_v1_r6_body_table_caption",
        "linking_v2_fc1_body_figure_caption"
      ]
    },
    "upstream_alias_id": {"type": ["string", "null"]},
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/target"}
    }
  },
  "allOf": [
    {
      "if": {"properties": {"alias_origin": {"const": "linking_v2_fc1_body_figure_caption"}}},
      "then": {
        "properties": {
          "alias_kind": {"const": "figure"},
          "upstream_alias_id": {"const": null},
          "targets": {
            "items": {
              "allOf": [
                {"$ref": "#/$defs/target"},
                {
                  "properties": {
                    "target_type": {"const": "figure"},
                    "evidence_kind": {"const": "attached_body_figure_caption"}
                  },
                  "required": [
                    "evidence_physical_page_number",
                    "evidence_image_record_ids",
                    "attachment_provenance",
                    "classification_provenance",
                    "structural_target_status",
                    "text_only_evidence_status"
                  ]
                }
              ]
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "nonemptyId": {"type": "string", "minLength": 1},
    "singletonIds": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/nonemptyId"}
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "target_id",
        "target_type",
        "upstream_target_id",
        "evidence_kind",
        "evidence_source_record_id",
        "evidence_page_id"
      ],
      "properties": {
        "target_id": {"$ref": "#/$defs/nonemptyId"},
        "target_type": {"enum": ["section", "table", "figure", "page", "document"]},
        "upstream_target_id": {"$ref": "#/$defs/nonemptyId"},
        "evidence_kind": {
          "enum": [
            "accepted_v2_alias",
            "verified_same_page_table_label",
            "r6_body_table_caption",
            "attached_body_figure_caption"
          ]
        },
        "evidence_source_record_id": {"type": ["string", "null"]},
        "evidence_page_id": {"type": ["string", "null"]},
        "evidence_physical_page_number": {"type": "integer", "minimum": 1},
        "evidence_image_record_ids": {"$ref": "#/$defs/singletonIds"},
        "attachment_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "caption_block_ids",
            "image_ids",
            "repeated_caption_reference_count",
            "repeated_image_reference_count"
          ],
          "properties": {
            "caption_block_ids": {"$ref": "#/$defs/singletonIds"},
            "image_ids": {"$ref": "#/$defs/singletonIds"},
            "repeated_caption_reference_count": {"type": "integer", "minimum": 0},
            "repeated_image_reference_count": {"type": "integer", "minimum": 0}
          }
        },
        "classification_provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "figure_content_layer",
            "figure_is_toc_row",
            "figure_semantic_placement",
            "figure_section_id",
            "caption_section_id",
            "caption_block_type",
            "caption_content_layer",
            "caption_is_toc_row"
          ],
          "properties": {
            "figure_content_layer": {"const": "body"},
            "figure_is_toc_row": {"const": false},
            "figure_semantic_placement": {"const": "inherited_nontext"},
            "figure_section_id": {"$ref": "#/$defs/nonemptyId"},
            "caption_section_id": {"$ref": "#/$defs/nonemptyId"},
            "caption_block_type": {"const": "caption"},
            "caption_content_layer": {"const": "body"},
            "caption_is_toc_row": {"const": false}
          }
        },
        "structural_target_status": {"const": "eligible"},
        "text_only_evidence_status": {"const": "not_evaluated_pending_task06h"}
      }
    }
  }
}
