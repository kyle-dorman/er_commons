<View className="question-review">
  <Style>
    .question-review { max-width: 1350px; margin: 0 auto; padding: 12px 16px 36px; color: #263b3a; font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; }
    .question-review h1 { font-size: 25px; margin: 0 0 6px; }
    .question-review h2 { font-size: 18px; margin: 0 0 14px; }
    .question-review .intro { color: #5e6d70; font-size: 14px; margin-bottom: 20px; line-height: 1.6; }
    .question-review .columns { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr); gap: 22px; align-items: start; }
    .question-review .card { border: 1px solid #dbe4e1; border-radius: 10px; padding: 22px; background: white; min-width: 0; }
    .question-review .edit-card { background: #f5f9f7; }
    .question-review .original pre { white-space: normal !important; overflow-wrap: anywhere; font: 15px/1.75 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; margin: 0; }
    .question-review .source { font-size: 12px; color: #657573; margin-bottom: 16px; }
    .question-review .help { color: #5b706b; font-size: 13px; line-height: 1.6; margin: 8px 0 16px; }
    .question-review textarea { font: 15px/1.65 -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif; background: white; padding: 12px; resize: vertical; }
    .question-review .list-editor textarea { min-height: 365px !important; }
    .question-review .status { margin-top: 22px; border-top: 1px solid #dbe4e1; padding-top: 18px; }
    .question-review .status label { font-size: 14px; }
    .question-review .proposal { margin-top: 20px; font-size: 14px; line-height: 1.65; }
    .question-review .proposal li { margin-bottom: 12px; }
    .question-review .note { margin-top: 20px; }
    @media (max-width: 1000px) { .question-review .columns { grid-template-columns: 1fr; } }
  </Style>
  <Header value="$comment_label" size="1" />
  <View className="intro"><Text name="instructions" value="Check that the list captures the comment faithfully and completely. Edit the wording or grouping as needed, then choose a status and submit." /></View>
  <View className="columns">
    <View className="card">
      <Header value="Original comment" size="2" />
      <View className="source"><Text name="source_summary" value="$source_summary" /></View>
      <View className="original"><HyperText name="comment" value="$comment_html" inline="true" selectionEnabled="false" /></View>
      <View className="help"><Text name="source_note" value="$source_note" /></View>
      <View className="proposal"><Collapse><Panel value="Initial proposal · unchanged">
        <HyperText name="proposal" value="$proposal_html" inline="true" selectionEnabled="false" />
      </Panel></Collapse></View>
    </View>
    <View className="card edit-card">
      <Header value="Your reviewed list" size="2" />
      <View className="help"><Text name="list_help" value="Use one numbered item per distinct question, concern, or request. Keep important qualifications; add nothing beyond the comment." /></View>
      <View className="list-editor"><TextArea name="concerns" toName="comment" rows="16" maxSubmissions="1" editable="true" transcription="true" showSubmitButton="false" placeholder="1. Question, concern, or request" /></View>
      <View className="status">
        <Header value="Review status" size="2" />
        <Choices name="review_status" toName="comment" choice="single-radio" showInline="true" required="true" requiredMessage="Choose a review status before submitting.">
          <Choice value="Approved" alias="approved" />
          <Choice value="Unclear" alias="unclear" />
          <Choice value="Needs context" alias="needs_context" />
        </Choices>
        <View className="help"><Text name="status_help" value="Approved: the edited list is faithful and complete. Unclear: the comment's intent is ambiguous. Needs context: specific source material is missing." /></View>
      </View>
      <View className="note">
        <Header value="Note · optional" size="2" />
        <TextArea name="review_note" toName="comment" rows="3" maxSubmissions="1" editable="true" transcription="true" showSubmitButton="false" placeholder="Anything unclear or missing?" />
      </View>
    </View>
  </View>
</View>
